# syntax=docker/dockerfile:1
# 開発環境用 Dockerfile。compose.yaml から参照される。
# 本番ビルドは Dockerfile を使う（Kamal 用、`rails new` 生成）。

ARG RUBY_VERSION=3.4.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
        build-essential \
        curl \
        git \
        libpq-dev \
        libyaml-dev \
        pkg-config \
        postgresql-client && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives

WORKDIR /rails

# informers の埋め込みモデルキャッシュを compose の volume に固定する。
# XDG_CACHE_HOME 配下の informers/ ディレクトリが実体（informers/env.rb 参照）。
ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_BIN=/usr/local/bundle/bin \
    PATH=/usr/local/bundle/bin:$PATH \
    XDG_CACHE_HOME=/rails-cache

RUN mkdir -p ${XDG_CACHE_HOME}

COPY Gemfile Gemfile.lock ./
RUN bundle install

CMD ["bash"]
