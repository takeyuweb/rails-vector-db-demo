<% content_for :title, "記事一覧" %>

<h1>記事一覧</h1>

<p>
  <%= link_to "新規作成", new_article_path %>
</p>

<% if @articles.any? %>
  <ul>
    <% @articles.each do |article| %>
      <li>
        <%= link_to article.title, article %>
        <small>(<%= l article.created_at, format: :short %>)</small>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>記事がありません。</p>
<% end %>
