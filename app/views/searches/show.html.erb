<% content_for :title, "類似記事検索" %>

<h1>類似記事検索</h1>

<%= form_with url: search_path, method: :get,
              data: { turbo_frame: "search_results" } do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "キーワードまたは質問文", size: 40 %>
  <%= form.submit "検索" %>
<% end %>

<%# 機能設計書 §5.2 Hotwire 活用方針: 結果領域を Turbo Frame として実装。
    target: "_top" で結果リスト中のリンクをフレーム外（記事詳細ページ）へ遷移させる。 %>
<%= turbo_frame_tag "search_results", target: "_top" do %>
  <%= render "result", query: @query, results: @results, search_failed: @search_failed %>
<% end %>
